# =============================================================================
# RootCauseway Development Environment Variables
# Copy to .env and adjust as needed.
# =============================================================================

# --- Backend (Go API) ---
JWT_SECRET=dev-jwt-secret-change-me

# AES-256 key for encrypting credentials at rest (base64-encoded 32 bytes).
# Generate with: openssl rand -base64 32
# If unset, credential encryption at rest is DISABLED (plaintext in DB).
ROOTCAUSEWAY_ENCRYPTION_KEY=
