# =============================================================================
# RootCauseway Production Environment Variables
# Copy to .env.prod and fill in real values before deploying.
# =============================================================================

# --- Docker Image Tag ---
IMAGE_TAG=latest

# --- PostgreSQL ---
POSTGRES_DB=rootcauseway
POSTGRES_USER=rootcauseway
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Backend (Go API) ---
DB_USER=rootcauseway
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_NAME=rootcauseway
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
LOG_LEVEL=info
# AES-256 key for encrypting credentials at rest (base64-encoded 32 bytes).
# Generate with: openssl rand -base64 32
# If unset, credential encryption at rest is DISABLED (plaintext in DB).
ROOTCAUSEWAY_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Anthropic (LLM) ---
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# --- Agent Service ---
# OPENAI_API_KEY=sk-CHANGE_ME  # if using OpenAI models

# --- Optional: Observability ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# SENTRY_DSN=https://...@sentry.io/...
